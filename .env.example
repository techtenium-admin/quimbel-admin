# Database — same Supabase / Postgres as quimbel-nextjs (pooled URL for runtime)
DATABASE_URL="postgresql://postgres.[project]:[password]@aws-region.pooler.supabase.com:6543/postgres"
DIRECT_DATABASE_URL="postgresql://postgres.[project]:[password]@aws-region.compute.amazonaws.com:5432/postgres"

# Resend — same as main app (ticket reply emails)
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_CONTACT="contact@yourdomain.com"
CONTACT_EMAIL="support@yourdomain.com"
EMAIL_NOREPLY="noreply@yourdomain.com"

# Main Quimbel app URL (links in support emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin UI session (sign cookie). Use JWT_SECRET from main app or a dedicated ADMIN_JWT_SECRET (≥32 chars).
JWT_SECRET="your_jwt_secret_here_min_32_chars"
# ADMIN_JWT_SECRET=

# Staff login password (bcrypt)
# node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Optional dev-only if hash unset:
# ADMIN_PASSWORD=
