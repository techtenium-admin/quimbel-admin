# ---------------------------------------------------------------------------
# Use the SAME file as quimbel-nextjs (recommended)
# ---------------------------------------------------------------------------
# From this directory (sibling to quimbel-nextjs):
#   ln -sf ../quimbel-nextjs/.env.local .env.local
#
# Then ensure these exist in that shared file (add any missing lines):
# ---------------------------------------------------------------------------

# Required on quimbel-nextjs for /api/admin — use the same value here
ADMIN_API_KEY=

# App URL (optional if NEXT_PUBLIC_APP_URL is already set in the shared file)
# MAIN_APP_URL=http://localhost:3000

# Staff login (bcrypt). Generate: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Optional: dedicated admin session secret. If omitted, JWT_SECRET from quimbel-nextjs is used (min 32 chars).
# ADMIN_JWT_SECRET=

# The following are typically already in quimbel-nextjs .env.local — quimbel-admin reads them too:
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# JWT_SECRET=...

# Dev-only if ADMIN_PASSWORD_HASH is unset (never in production):
# ADMIN_PASSWORD=
